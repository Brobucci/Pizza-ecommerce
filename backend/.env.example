# ============================================================
# Variabili d'ambiente del backend.
#
# Copia questo file come ".env" nella cartella backend/ e
# sostituisci i valori di esempio con quelli reali.
# Il file .env contiene segreti: NON va mai committato
# (è escluso dal .gitignore). Questo file di esempio invece sì.
# ============================================================

# Utente MySQL dedicato all'applicazione, con permessi solo sullo schema pizzadb
DB_USERNAME=pizzeria_app
DB_PASSWORD=inserisci_la_password

# Chiave per firmare i token JWT (HS256): almeno 32 byte casuali.
# Generala con:  openssl rand -base64 32
JWT_SECRET=inserisci_una_chiave_generata
